{
  "entities": {
    "feedback": {
      "title": "User Feedback",
      "description": "User feedback, suggestions, and ratings stored permanently in Google Cloud Firestore",
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "description": "Name or alias of the person providing feedback",
          "maxLength": 100
        },
        "email": {
          "type": "string",
          "description": "Optional email for follow-up",
          "maxLength": 150
        },
        "rating": {
          "type": "number",
          "description": "Rating score from 1 to 5 stars"
        },
        "category": {
          "type": "string",
          "description": "Feedback category (Forslag, Ros, Fejl/Hjælp, Boligønske)"
        },
        "message": {
          "type": "string",
          "description": "Detailed feedback message",
          "maxLength": 2000
        },
        "createdAt": {
          "type": "string",
          "description": "Timestamp formatted string or ISO timestamp"
        }
      },
      "required": ["name", "rating", "category", "message"]
    }
  },
  "firestore": {
    "/feedback/{feedbackId}": {
      "schema": "feedback",
      "description": "Permanent collection of user and member feedback stored in Firestore"
    }
  }
}
